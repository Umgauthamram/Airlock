# ==============================================================================
# Airlock Environment Configuration Template
# Copy this file to .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Common Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
DEMO_MODE=1

# ------------------------------------------------------------------------------
# 2. Redis Configuration (Redis Stack with JSON, Search & Streams)
# For local Docker Compose: redis://:airlocklocal@localhost:6379
# For Redis Cloud: rediss://<username>:<password>@<host>:<port>
# ------------------------------------------------------------------------------
REDIS_URL=redis://:airlocklocal@localhost:6379

# ------------------------------------------------------------------------------
# 3. Control Plane (apps/web) - Auth.js v5 & Next.js
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=airlock_local_dev_secret_32_characters_long_min_12345
AUTH_URL=http://localhost:3000

# Google OAuth Credentials (for production / human access)
AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# Initial Bootstrap Admins (comma-separated email list)
BOOTSTRAP_ADMIN_EMAILS=admin@airlock.local,operator@airlock.local

# Optional hosted domain restriction (e.g. yourcompany.com)
# ALLOWED_EMAIL_DOMAIN=yourcompany.com

# URL of the Gateway service accessible by the Web control plane
GATEWAY_PUBLIC_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 4. Data Plane (apps/gateway & worker)
# ------------------------------------------------------------------------------
PORT=4000

# 32-byte hexadecimal master key for encrypting upstream credentials (AES-256-GCM)
# Generate with: openssl rand -hex 32
AIRLOCK_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. NVIDIA / Nebius Model Inference (Only required on Data Plane / VM)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Model Tier IDs on Nebius Token Factory
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

