# Web Control Plane Environment Variables (Vercel / Local)
NODE_ENV=development
DEMO_MODE=1

# Redis Connection (Web ACL user or local Redis Stack)
REDIS_URL=redis://:airlocklocal@127.0.0.1:6379

# Auth.js v5 Configuration
AUTH_SECRET=airlock_local_dev_secret_32_characters_long_min_12345
AUTH_URL=http://localhost:3000

# Google OAuth Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bootstrap Admins & Gateway URL
BOOTSTRAP_ADMIN_EMAILS=admin@airlock.local
GATEWAY_PUBLIC_URL=http://localhost:4000
