{
    admin off
    auto_https off
}

:80 {
    # Health checks
    handle /healthz {
        reverse_proxy gateway:4000
    }

    # Gateway API and MCP protocols
    handle /mcp* {
        reverse_proxy gateway:4000
    }

    handle /api/gateway/* {
        uri strip_prefix /api/gateway
        reverse_proxy gateway:4000
    }

    # Web Dashboard and User Interface
    handle {
        reverse_proxy web:3000
    }

    # Global Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

