{
    email admin@airlock.local
}

# Gateway public domain with automatic TLS and reverse proxy
{$GATEWAY_DOMAIN:gateway.airlock.local} {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Reverse proxy to Node.js Gateway
    reverse_proxy gateway:4000 {
        health_uri /healthz
        health_interval 10s
        health_timeout 2s
    }
}
